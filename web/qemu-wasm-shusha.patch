diff --git a/include/glib-compat.h b/include/glib-compat.h
index 43a562974d..affddcd4c1 100644
--- a/include/glib-compat.h
+++ b/include/glib-compat.h
@@ -151,4 +151,31 @@ qemu_g_test_slow(void)
 #define G_NORETURN G_GNUC_NORETURN
 #endif
 
+#ifdef __EMSCRIPTEN__
+/*
+ * glib calls a GCompareFunc through a GCompareDataFunc pointer with an extra
+ * argument.  Native ABIs tolerate that; WebAssembly traps on the signature
+ * mismatch.  Route every two-argument comparator through a trampoline.
+ */
+static inline gint qemu_wasm_cmp_tramp(gconstpointer a, gconstpointer b,
+                                       gpointer f)
+{
+    return ((GCompareFunc)f)(a, b);
+}
+#define g_slist_sort(l, f) \
+    g_slist_sort_with_data((l), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_list_sort(l, f) \
+    g_list_sort_with_data((l), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_slist_insert_sorted(l, d, f) \
+    g_slist_insert_sorted_with_data((l), (d), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_list_insert_sorted(l, d, f) \
+    g_list_insert_sorted_with_data((l), (d), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_array_sort(a, f) \
+    g_array_sort_with_data((a), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_ptr_array_sort(a, f) \
+    g_ptr_array_sort_with_data((a), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_tree_new(f) \
+    g_tree_new_with_data(qemu_wasm_cmp_tramp, (gpointer)(f))
+#endif
+
 #endif
diff --git a/net/browser.c b/net/browser.c
new file mode 100644
index 0000000000..2c1df4e08c
--- /dev/null
+++ b/net/browser.c
@@ -0,0 +1,115 @@
+/*
+ * Browser network backend for QEMU built with Emscripten.
+ *
+ * Ethernet frames go to and from the page through two rings of fixed-size
+ * slots in shared memory.  Frames the guest sends are written to the TX ring
+ * and the page is told to drain it; the page puts frames from other
+ * instances (a BroadcastChannel acting as an Ethernet hub) in the RX ring,
+ * and a timer on the QEMU main loop drains that into the guest NIC.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "net/net.h"
+#include "clients.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+#define BROWSER_SLOTS     256
+#define BROWSER_SLOT_SIZE 2048      /* int32 length + frame (<= 2044 bytes) */
+#define BROWSER_POLL_MS   2
+
+/* [0] tx head (we write) [1] tx tail (page) [2] rx head (page) [3] rx tail (we) */
+static int32_t browser_shared[4];
+static uint8_t browser_tx[BROWSER_SLOTS * BROWSER_SLOT_SIZE];
+static uint8_t browser_rx[BROWSER_SLOTS * BROWSER_SLOT_SIZE];
+
+typedef struct BrowserNetState {
+    NetClientState nc;
+    QEMUTimer *timer;
+} BrowserNetState;
+
+static ssize_t browser_receive(NetClientState *nc, const uint8_t *buf,
+                               size_t size)
+{
+    int32_t head = qatomic_read(&browser_shared[0]);
+    int32_t tail = qatomic_load_acquire(&browser_shared[1]);
+
+    if (size > BROWSER_SLOT_SIZE - 4 || head - tail >= BROWSER_SLOTS) {
+        return size;            /* too big, or the page is behind: drop */
+    }
+    uint8_t *slot = &browser_tx[(head % BROWSER_SLOTS) * BROWSER_SLOT_SIZE];
+    *(int32_t *)slot = (int32_t)size;
+    memcpy(slot + 4, buf, size);
+    qatomic_store_release(&browser_shared[0], head + 1);
+#ifdef __EMSCRIPTEN__
+    MAIN_THREAD_ASYNC_EM_ASM({
+        if (Module.netTx) {
+            Module.netTx();
+        }
+    });
+#endif
+    return size;
+}
+
+static void browser_poll(void *opaque)
+{
+    BrowserNetState *s = opaque;
+    int32_t head = qatomic_load_acquire(&browser_shared[2]);
+    int32_t tail = qatomic_read(&browser_shared[3]);
+
+    while (tail != head && qemu_can_send_packet(&s->nc)) {
+        uint8_t *slot = &browser_rx[(tail % BROWSER_SLOTS) * BROWSER_SLOT_SIZE];
+        int32_t len = *(int32_t *)slot;
+        if (len > 0 && len <= BROWSER_SLOT_SIZE - 4) {
+            qemu_send_packet(&s->nc, slot + 4, len);
+        }
+        tail++;
+    }
+    qatomic_store_release(&browser_shared[3], tail);
+    timer_mod(s->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + BROWSER_POLL_MS);
+}
+
+static void browser_cleanup(NetClientState *nc)
+{
+    BrowserNetState *s = DO_UPCAST(BrowserNetState, nc, nc);
+    if (s->timer) {
+        timer_free(s->timer);
+        s->timer = NULL;
+    }
+}
+
+static NetClientInfo net_browser_info = {
+    .type = NET_CLIENT_DRIVER_BROWSER,
+    .size = sizeof(BrowserNetState),
+    .receive = browser_receive,
+    .cleanup = browser_cleanup,
+};
+
+int net_init_browser(const Netdev *netdev, const char *name,
+                     NetClientState *peer, Error **errp)
+{
+    NetClientState *nc;
+    BrowserNetState *s;
+
+    assert(netdev->type == NET_CLIENT_DRIVER_BROWSER);
+    nc = qemu_new_net_client(&net_browser_info, peer, "browser", name);
+    s = DO_UPCAST(BrowserNetState, nc, nc);
+    qemu_set_info_str(nc, "browser: page rings");
+    s->timer = timer_new_ms(QEMU_CLOCK_REALTIME, browser_poll, s);
+    timer_mod(s->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + BROWSER_POLL_MS);
+#ifdef __EMSCRIPTEN__
+    MAIN_THREAD_ASYNC_EM_ASM({
+        if (Module.netInit) {
+            Module.netInit($0, $1, $2, $3, $4);
+        }
+    }, browser_shared, browser_tx, browser_rx, BROWSER_SLOTS, BROWSER_SLOT_SIZE);
+#endif
+    return 0;
+}
