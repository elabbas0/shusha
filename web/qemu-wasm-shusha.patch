diff --git a/ui/canvas.c b/ui/canvas.c
new file mode 100644
index 0000000000..6602f0b81a
--- /dev/null
+++ b/ui/canvas.c
@@ -0,0 +1,291 @@
+/*
+ * Browser canvas display for QEMU built with Emscripten.
+ *
+ * The guest's graphic console is converted to RGBA and handed to the page
+ * through a shared buffer; the page draws it with putImageData.  Keyboard and
+ * pointer events come back through a ring in shared memory that the page
+ * fills with Atomics and this listener drains on every refresh tick, on the
+ * QEMU main loop thread.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include "qemu/module.h"
+#include "ui/console.h"
+#include "ui/input.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+#define CANVAS_RING_EVENTS 1024
+
+enum {
+    CANVAS_EV_KEY = 1,     /* a = linux keycode, b = down */
+    CANVAS_EV_ABS = 2,     /* a = x, b = y, in canvas pixels */
+    CANVAS_EV_BTN = 3,     /* a = 0 left / 1 middle / 2 right, b = down */
+    CANVAS_EV_WHEEL = 4,   /* a = 1 up / -1 down */
+};
+
+/* [0] frame pending, [1] ring head (page writes), [2] ring tail (we write) */
+static int32_t canvas_shared[4];
+static int32_t canvas_ring[CANVAS_RING_EVENTS * 4];
+
+typedef struct CanvasDisplay {
+    DisplayChangeListener dcl;
+    DisplaySurface *surface;
+    pixman_image_t *rgba;
+    uint32_t *buf;
+    int width, height;
+    bool dirty;
+    /* Where we believe a relative (PS/2) guest pointer is; see canvas_abs */
+    int px, py, tx, ty;
+    bool homed, homing;
+} CanvasDisplay;
+
+static void canvas_resize(CanvasDisplay *cd, int w, int h)
+{
+    if (cd->rgba && cd->width == w && cd->height == h) {
+        return;
+    }
+    while (qatomic_read(&canvas_shared[0])) {
+        /* the page is still copying the old buffer */
+        g_usleep(1000);
+    }
+    if (cd->rgba) {
+        pixman_image_unref(cd->rgba);
+        g_free(cd->buf);
+    }
+    cd->width = w;
+    cd->height = h;
+    cd->buf = g_malloc0((size_t)w * h * 4);
+    /* a8b8g8r8 is R,G,B,A in memory on little endian: what ImageData wants */
+    cd->rgba = pixman_image_create_bits(PIXMAN_a8b8g8r8, w, h, cd->buf, w * 4);
+}
+
+static void canvas_push_frame(CanvasDisplay *cd)
+{
+    if (!cd->surface || !cd->rgba || qatomic_read(&canvas_shared[0])) {
+        return;
+    }
+    pixman_image_composite(PIXMAN_OP_SRC, cd->surface->image, NULL, cd->rgba,
+                           0, 0, 0, 0, 0, 0, cd->width, cd->height);
+    cd->dirty = false;
+    qatomic_set(&canvas_shared[0], 1);
+#ifdef __EMSCRIPTEN__
+    MAIN_THREAD_ASYNC_EM_ASM({
+        if (Module.canvasFrame) {
+            Module.canvasFrame($0, $1, $2, $3);
+        } else {
+            Atomics.store(HEAP32, $3 >> 2, 0);
+        }
+    }, cd->buf, cd->width, cd->height, &canvas_shared[0]);
+#else
+    qatomic_set(&canvas_shared[0], 0);
+#endif
+}
+
+/*
+ * Guests without an absolute pointer (no USB tablet driver) only see the
+ * PS/2 mouse.  For those we keep where the guest pointer should be and walk
+ * it towards the page's pointer with relative moves, assuming the guest
+ * moves 1:1 and clamps to the screen like we do.  At most CANVAS_REL_STEP
+ * per axis goes out per refresh, so the moves fit in the PS/2 queue and are
+ * never merged with later ones.  We start by "believing" the pointer is far
+ * beyond the bottom right and walking it to (0, 0), which pins it in the
+ * corner whatever its real position; only then do we follow the page.
+ */
+#define CANVAS_REL_STEP 240
+
+static bool canvas_relative(CanvasDisplay *cd)
+{
+    return !qemu_input_is_absolute(cd->dcl.con);
+}
+
+static void canvas_abs(CanvasDisplay *cd, int x, int y)
+{
+    QemuConsole *con = cd->dcl.con;
+
+    if (!canvas_relative(cd)) {
+        qemu_input_queue_abs(con, INPUT_AXIS_X, x, 0, cd->width);
+        qemu_input_queue_abs(con, INPUT_AXIS_Y, y, 0, cd->height);
+        return;
+    }
+    if (!cd->homed) {
+        cd->px = 2 * cd->width + 64;
+        cd->py = 2 * cd->height + 64;
+        cd->homed = true;
+        cd->homing = true;
+    }
+    cd->tx = MAX(0, MIN(cd->width - 1, x));
+    cd->ty = MAX(0, MIN(cd->height - 1, y));
+}
+
+static void canvas_rel_step(CanvasDisplay *cd)
+{
+    int dx, dy;
+
+    if (!cd->homed) {
+        return;
+    }
+    if (cd->homing && cd->px == 0 && cd->py == 0) {
+        cd->homing = false;
+    }
+    dx = MAX(-CANVAS_REL_STEP, MIN(CANVAS_REL_STEP, (cd->homing ? 0 : cd->tx) - cd->px));
+    dy = MAX(-CANVAS_REL_STEP, MIN(CANVAS_REL_STEP, (cd->homing ? 0 : cd->ty) - cd->py));
+    if (dx || dy) {
+        qemu_input_queue_rel(cd->dcl.con, INPUT_AXIS_X, dx);
+        qemu_input_queue_rel(cd->dcl.con, INPUT_AXIS_Y, dy);
+        qemu_input_event_sync();
+        cd->px += dx;
+        cd->py += dy;
+    }
+}
+
+static void canvas_drain_input(CanvasDisplay *cd)
+{
+    QemuConsole *con = cd->dcl.con;
+    int32_t head = qatomic_load_acquire(&canvas_shared[1]);
+    int32_t tail = qatomic_read(&canvas_shared[2]);
+    bool sync = false;
+
+    while (tail != head) {
+        int32_t *ev = &canvas_ring[(tail % CANVAS_RING_EVENTS) * 4];
+        static const InputButton btns[3] = {
+            INPUT_BUTTON_LEFT, INPUT_BUTTON_MIDDLE, INPUT_BUTTON_RIGHT,
+        };
+
+        switch (ev[0]) {
+        case CANVAS_EV_KEY:
+            if (ev[1] > 0 && ev[1] < qemu_input_map_linux_to_qcode_len) {
+                QKeyCode q = qemu_input_map_linux_to_qcode[ev[1]];
+                if (q) {
+                    qemu_input_event_send_key_qcode(con, q, ev[2] != 0);
+                }
+            }
+            break;
+        case CANVAS_EV_ABS:
+            if (cd->width && cd->height) {
+                canvas_abs(cd, ev[1], ev[2]);
+                sync = !canvas_relative(cd);
+            }
+            break;
+        case CANVAS_EV_BTN:
+            if (canvas_relative(cd) && cd->homed &&
+                (cd->homing || cd->px != cd->tx || cd->py != cd->ty)) {
+                /* click where the pointer will be: finish moving first */
+                goto out;
+            }
+            if (ev[1] >= 0 && ev[1] < 3) {
+                /*
+                 * Sync each button change on its own: a press and release
+                 * drained in the same tick would otherwise cancel out.
+                 */
+                if (sync) {
+                    qemu_input_event_sync();
+                    sync = false;
+                }
+                qemu_input_queue_btn(con, btns[ev[1]], ev[2] != 0);
+                qemu_input_event_sync();
+            }
+            break;
+        case CANVAS_EV_WHEEL: {
+            InputButton b = ev[1] > 0 ? INPUT_BUTTON_WHEEL_UP
+                                      : INPUT_BUTTON_WHEEL_DOWN;
+            qemu_input_queue_btn(con, b, true);
+            qemu_input_event_sync();
+            qemu_input_queue_btn(con, b, false);
+            sync = true;
+            break;
+        }
+        }
+        tail++;
+    }
+out:
+    qatomic_store_release(&canvas_shared[2], tail);
+    if (sync) {
+        qemu_input_event_sync();
+    }
+    if (canvas_relative(cd)) {
+        canvas_rel_step(cd);
+    }
+}
+
+static void canvas_refresh(DisplayChangeListener *dcl)
+{
+    CanvasDisplay *cd = container_of(dcl, CanvasDisplay, dcl);
+
+    graphic_hw_update(dcl->con);
+    canvas_drain_input(cd);
+    if (cd->dirty) {
+        canvas_push_frame(cd);
+    }
+}
+
+static void canvas_gfx_update(DisplayChangeListener *dcl,
+                              int x, int y, int w, int h)
+{
+    CanvasDisplay *cd = container_of(dcl, CanvasDisplay, dcl);
+    cd->dirty = true;
+}
+
+static void canvas_gfx_switch(DisplayChangeListener *dcl,
+                              DisplaySurface *surface)
+{
+    CanvasDisplay *cd = container_of(dcl, CanvasDisplay, dcl);
+
+    cd->surface = surface;
+    if (surface) {
+        canvas_resize(cd, surface_width(surface), surface_height(surface));
+#ifdef __EMSCRIPTEN__
+        MAIN_THREAD_ASYNC_EM_ASM({
+            if (Module.canvasResize) {
+                Module.canvasResize($0, $1);
+            }
+        }, cd->width, cd->height);
+#endif
+    }
+    cd->dirty = true;
+}
+
+static const DisplayChangeListenerOps canvas_ops = {
+    .dpy_name       = "canvas",
+    .dpy_refresh    = canvas_refresh,
+    .dpy_gfx_update = canvas_gfx_update,
+    .dpy_gfx_switch = canvas_gfx_switch,
+};
+
+static void canvas_init(DisplayState *ds, DisplayOptions *opts)
+{
+    QemuConsole *con = qemu_console_lookup_by_index(0);
+    CanvasDisplay *cd;
+
+    if (!con || !qemu_console_is_graphic(con)) {
+        return;
+    }
+    cd = g_new0(CanvasDisplay, 1);
+    cd->dcl.con = con;
+    cd->dcl.ops = &canvas_ops;
+    register_displaychangelistener(&cd->dcl);
+#ifdef __EMSCRIPTEN__
+    MAIN_THREAD_ASYNC_EM_ASM({
+        if (Module.canvasInit) {
+            Module.canvasInit($0, $1, $2);
+        }
+    }, canvas_ring, canvas_shared, CANVAS_RING_EVENTS);
+#endif
+}
+
+static QemuDisplay qemu_display_canvas = {
+    .type = DISPLAY_TYPE_CANVAS,
+    .init = canvas_init,
+};
+
+static void register_canvas(void)
+{
+    qemu_display_register(&qemu_display_canvas);
+}
+
+type_init(register_canvas);
